			<p class="mt-2">
				<a href="/politica-privacidad" class="hover:text-secondary">Política de Privacidad</a> | 
				<a href="/terminos-condiciones" class="hover:text-secondary">Términos y Condiciones</a>
			</p>
			-->
		</div>
	</div>
</footer>

