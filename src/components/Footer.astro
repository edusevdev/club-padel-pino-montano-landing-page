---
import { Icon } from 'astro-icon/components'
---

<footer class="bg-primary text-white py-8">
	<div class="container mx-auto px-4">
		<div class="flex flex-wrap justify-between items-center">
			<div class="w-full md:w-1/3 mb-6 md:mb-0">
				<img src="/logo-club-padel-pino-montano.png" alt="Club de Padel Pino Montano" class="h-12 mb-4">
				<p>41015, Sevilla</p>
				<p>info@gmail.com</p>
			</div>
			<div class="w-full md:w-1/3 mb-6 md:mb-0">
				<h3 class="text-xl font-bold mb-4">Enlaces rápidos</h3>
				<ul class="space-y-2">
					<li><a href="#inicio" class="hover:text-secondary">Inicio</a></li>
					<li><a href="#sobre-nosotros" class="hover:text-secondary">Sobre Nosotros</a></li>
					<li><a href="#eventos" class="hover:text-secondary">Instalaciones</a></li>
					<li><a href="#beneficios" class="hover:text-secondary">Beneficios</a></li>
					<li><a href="#contacto" class="hover:text-secondary">Contacto</a></li>
				</ul>
			</div>
			<div class="w-full md:w-1/3">
				<h3 class="text-xl font-bold mb-4">Síguenos</h3>
				<div class="flex space-x-4">
					<a href="#" class="hover:text-secondary"><Icon name="mdi:facebook" class="w-6 h-6" /></a>
					<a href="#" class="hover:text-secondary"><Icon name="mdi:twitter" class="w-6 h-6" /></a>
					<a href="#" class="hover:text-secondary"><Icon name="mdi:instagram" class="w-6 h-6" /></a>
				</div>
			</div>
		</div>
		<div class="mt-8 text-center">
			<p>&copy; 2025 Club de Pádel Pino Montano. Todos los derechos reservados.</p>
