---
const testimonials = [
	{ name: 'Ana García', image: '/testimonial-1.jpg', text: 'Increíble ambiente y excelentes instalaciones. ¡Me encanta ser parte de este club!' },
	{ name: 'Carlos Rodríguez', image: '/testimonial-2.jpg', text: 'Los entrenadores son fantásticos y he mejorado mucho mi juego desde que me uní.' },
	{ name: 'Laura Martínez', image: '/testimonial-3.jpg', text: 'La comunidad es genial y he hecho muchos amigos. ¡Recomiendo totalmente La Remate!' },
];
---

<section class="py-16 bg-gray-100">
	<div class="container mx-auto px-4">
		<h2 class="text-3xl font-bold text-center mb-12">Lo que dicen nuestros socios</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			{testimonials.map(testimonial => (
				<div class="bg-white p-6 rounded-lg shadow-md">
					<img src={testimonial.image || "/placeholder.svg"} alt={testimonial.name} class="w-20 h-20 rounded-full mx-auto mb-4">
					<p class="text-center mb-4">{testimonial.text}</p>
					<p class="text-center font-bold">{testimonial.name}</p>
				</div>
			))}
		</div>
	</div>
</section>

